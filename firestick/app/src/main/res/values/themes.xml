<resources>
    <style name="Theme.Home" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@drawable/bg</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">#FFFFFF</item>
    </style>

    <!-- Dream Player: black from the first frame (no flash), no title, no window animation. -->
    <style name="Theme.DreamPlayer" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorAccent">#FFFFFF</item>
    </style>
</resources>
